# Copy to ops/.env and fill in. Never commit .env.
#
# T3N_API_KEY is a secp256k1 PRIVATE KEY (0x + 64 hex), not a bearer token.
# The SDK derives an address from it and signs a challenge. Claim it at
# https://go.terminal3.io/adk-community  (shown once).
T3N_API_KEY=0x...

# Optional. If set, the CLI refuses to run when the authenticated DID does not
# match, which catches "wrong key in the environment" before it does anything.
T3N_DID=did:t3n:...
